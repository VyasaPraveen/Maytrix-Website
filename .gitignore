/vendor/
.DS_Store
Thumbs.db
*.local.php

# Editor / tooling
/.qodo/
/.idea/
/.vscode/
*.swp

# Generated backups (downloaded via the dashboard)
/storage/backups/*
!/storage/backups/.gitkeep
