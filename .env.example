# ==========================================================================
# Maytrix Education — Environment Configuration
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ==========================================================================

# Application
APP_NAME="Maytrix Education"
APP_ENV=production            # local | production
APP_DEBUG=false              # true only in local/dev
APP_URL=https://maytrixeducation.com
APP_TIMEZONE=Asia/Kolkata

# Database driver:  mysql (Hostinger / production)  |  sqlite (local dev)
DB_DRIVER=mysql

# ----- MySQL (production / Hostinger) -----
# Two SEPARATE databases as per project requirement.
# CONTENT / WEBSITE database (public site reads, dashboard writes content)
DB_WEB_HOST=localhost
DB_WEB_PORT=3306
DB_WEB_NAME=maytrix_web
DB_WEB_USER=maytrix_web_user
DB_WEB_PASS=change_me

# ADMIN / AUTH database (admin accounts, sessions, audit log)
DB_ADMIN_HOST=localhost
DB_ADMIN_PORT=3306
DB_ADMIN_NAME=maytrix_admin
DB_ADMIN_USER=maytrix_admin_user
DB_ADMIN_PASS=change_me

# ----- SQLite (local development only; used when DB_DRIVER=sqlite) -----
DB_WEB_SQLITE=storage/sqlite/maytrix_web.sqlite
DB_ADMIN_SQLITE=storage/sqlite/maytrix_admin.sqlite

# Security
APP_KEY=                     # 32+ random chars, used for CSRF / hashing salt
SESSION_NAME=maytrix_sess

# Mail (SMTP) — used for booking/enrolment confirmations
MAIL_ENABLED=false
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@maytrixeducation.com
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS=no-reply@maytrixeducation.com
MAIL_FROM_NAME="Maytrix Education"
MAIL_ADMIN_NOTIFY=admin@maytrixeducation.com

# Payment gateways (keys entered here OR via dashboard Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYMENT_CURRENCY=INR

# Analytics
GA_MEASUREMENT_ID=           # e.g. G-XXXXXXXXXX
